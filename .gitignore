```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/

# Dependencies
vendor/
node_modules/
composer.lock

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Database
*.sql.bak
*.db.bak

# Coverage reports
coverage/
htmlcov/
.coverage

# Build directories
dist/
build/
target/
```